{
  "name": "nepras-desktop",
  "productName": "Nepras",
  "version": "1.3.42",
  "description": "نبراس لإدارة الحكومة الإلكترونية - تطبيق سطح المكتب",
  "main": "src/main.js",
  "author": "Nepras",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "node ../scripts/build.js desktop",
    "dist": "node ../scripts/build.js desktop && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "eg.gov.nepras.desktop",
    "productName": "Nepras",
    "compression": "normal",
    "directories": { "output": "../release/desktop" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [{ "from": "../dist/desktop", "to": "dist" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "Nepras_Setup_${version}.${ext}"
    },
    "portable": { "artifactName": "Nepras_Portable_${version}.${ext}" }
  }
}

